# Copy this file to `.env` and fill in your Lineup instance.
# `.env` is gitignored and never uploaded to GitHub.

# Origin of the Lineup API, without a trailing slash.
API_BASE=https://your-lineup-app.example.com

# Optional. Derived from API_BASE when omitted.
# API_HOST=your-lineup-app.example.com

# Bearer token. Leave empty while the API is open.
API_TOKEN=
